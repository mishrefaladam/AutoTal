// AutoTal – Prisma Schema
//
// Konventionen:
// - Geldbeträge werden als Integer in Cent gespeichert (`*Cents`). Damit sind
//   Preise exakt und über die Server/Client-Grenze JSON-serialisierbar.
// - Prozentsätze werden als Integer in Basispunkten gespeichert (`*Bp`),
//   z. B. 599 = 5,99 %. Konvertierung siehe src/lib/money.ts.
// - Formulardaten (Kontakt, Probefahrt, Fahrzeuganfrage, Ankauf) werden
//   BEWUSST NICHT persistiert. Sie gehen ausschließlich per Resend raus.
//   Siehe src/modules/forms. Bitte kein "Leads"-Modell ergänzen, ohne die
//   Datenschutzerklärung anzupassen.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Fahrzeuge
// ---------------------------------------------------------------------------

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  LPG
  CNG
  HYDROGEN
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  SEMI_AUTOMATIC
}

enum BodyType {
  SMALL_CAR
  SEDAN
  ESTATE
  SUV
  COUPE
  CONVERTIBLE
  VAN
  TRANSPORTER
  PICKUP
  OTHER
}

/// Verkaufsstatus eines von AutoTal selbst gehaltenen Fahrzeugs.
///
/// Getrennt von `active`: `active` steuert nur die Sichtbarkeit im Admin,
/// `status` beschreibt die tatsächliche Verfügbarkeit.
enum VehicleStatus {
  IN_STOCK
  RESERVED
  SOLD
}

/// Antriebsart. Nullable am Fahrzeug: Steht sie nirgends, wird sie nicht geraten.
enum DrivetrainType {
  FRONT_WHEEL
  REAR_WHEEL
  ALL_WHEEL
}

enum VehicleCondition {
  NEW
  USED
  DEMO
  ANNUAL_CAR
}

/// Ein im Admin erfasstes Fahrzeug.
///
/// Bildet NICHT den öffentlichen Fahrzeugbestand ab – der kommt aus der
/// eingebetteten willhaben-Fahrzeugbörse. Diese Datensätze sind die
/// Datenbasis für die Social-Media-Funktion.
///
/// `externalSource` + `externalId` bleiben erhalten, damit später eine echte
/// Datenquelle danebentreten kann, ohne bestehende Datensätze anzufassen.
model Vehicle {
  id   String @id @default(cuid())
  /// URL-Segment für /fahrzeuge/[slug]
  slug String @unique

  // -- Provider-Herkunft (US-06) -------------------------------------------
  /// Herkunft des Datensatzes, derzeit immer "manual"
  externalSource String
  /// ID des Fahrzeugs beim Anbieter
  externalId     String
  lastSyncedAt   DateTime @default(now())
  /// false = im Admin ausgeblendet
  active         Boolean  @default(true)

  // -- Stammdaten ------------------------------------------------------------
  make    String
  model   String
  variant String?

  /// Beworbener Preis – das, was Kundinnen und Kunden sehen. Entspricht dem
  /// Angebotspreis der Bestands-CSV.
  priceCents Int
  /// Verkaufs-/Listenpreis vor einem Aktionspreis. Nur gesetzt, wenn er
  /// tatsächlich abweicht; sonst gibt es nur den einen Preis.
  listPriceCents Int?
  /// Vorsteuerabzugsberechtigt (österreichische Händlerpraxis)
  vatDeductible Boolean @default(false)

  mileageKm         Int
  firstRegistration DateTime?
  /// Kraftstoff und Getriebe sind optional, weil der CSV-Bestandsimport sie
  /// nicht liefert. Sie zu raten wäre schädlich: Die Caption-Erzeugung führt
  /// jede gesetzte Angabe als Tatsache in den Prompt. NULL heißt "keine
  /// Angabe" und wird dort weggelassen, statt etwas zu behaupten.
  fuel              FuelType?
  transmission      TransmissionType?
  bodyType          BodyType         @default(OTHER)
  condition         VehicleCondition @default(USED)

  powerKw        Int?
  displacementCcm Int?
  color          String?
  doors          Int?
  seats          Int?
  previousOwners Int?

  // -- Ergänzende Fahrzeugdaten ----------------------------------------------
  // Durchweg nullable: Weder CSV noch Preisblatt liefern alles, und ein
  // Standardwert wäre hier eine Falschangabe – die Caption-Erzeugung führt
  // jedes gesetzte Feld als Tatsache.
  /// Antrieb (Vorderrad, Hinterrad, Allrad).
  drivetrain    DrivetrainType?
  /// Nationaler Code der Typisierung (Österreich).
  nationalCode  String?
  /// Fahrzeugtyp laut Händlersystem, z. B. "PKW". Freitext, weil die Quellen
  /// keine gemeinsame Werteliste haben.
  vehicleType   String?
  /// Höchstzulässiges Gesamtgewicht in Kilogramm.
  grossWeightKg Int?
  /// Standzeit in Tagen aus dem Bestandsexport.
  daysInStock   Int?
  /// §57a-Begutachtung ("Pickerl") gültig bis
  inspectionValidUntil DateTime?

  description String  @default("")
  /// Ausstattungsliste (US-05)
  features    String[] @default([])
  /// Zusätzlich verbaute Extras, getrennt von der Serienausstattung.
  extras      String[] @default([])
  /// Kurze Verkaufsargumente. Das Preisblatt liefert sie als Highlights_1..12.
  highlights  String[] @default([])

  // -- Bestandsführung -------------------------------------------------------
  /// Verfügbarkeit im eigenen Bestand
  status VehicleStatus @default(IN_STOCK)
  /// Gesetzt, sobald status auf SOLD wechselt
  soldAt DateTime?
  /// Nur im Admin sichtbar, nie öffentlich ausgegeben
  internalNotes String @default("")

  // -- Bestandsimport (CSV) ---------------------------------------------------
  // Rein additiv: Von Hand angelegte Fahrzeuge lassen alle Felder leer und
  // verhalten sich unverändert.
  /// Bestandsnummer des Händlersystems ("GW-Nr"). Zweitstärkstes Merkmal beim
  /// Zuordnen einer Importzeile.
  stockNumber String?
  /// Fahrgestellnummer ("FIN"). Stärkstes Merkmal beim Zuordnen.
  vin         String?
  /// Erster Import, aus dem dieser Datensatz stammt.
  importedAt         DateTime?
  /// Letzter Import, in dem das Fahrzeug enthalten war.
  lastSeenInImportAt DateTime?
  /// Gesetzt, sobald ein Import das Fahrzeug NICHT mehr enthielt.
  ///
  /// Ausdrücklich nur ein Hinweis zum Nachsehen: Der Import ändert daraufhin
  /// weder Status noch Sichtbarkeit und löscht nichts. Ob das Fahrzeug
  /// verkauft ist, entscheidet der Händler.
  missingSinceImportAt DateTime?
  /// Dateiname des letzten Imports – damit nachvollziehbar bleibt, woher der
  /// Stand stammt.
  importSource   String?
  /// Auffälligkeiten der zuletzt eingelesenen Zeile, für den Admin lesbar.
  importWarnings String[] @default([])
  /// Ersatzkennung aus Marke, Modell, Baujahr und Kilometerstand.
  ///
  /// Nur belegt, wenn der Bestandsexport weder FIN noch GW-Nr liefert. Sie
  /// hält fest, woran der Import dieses Fahrzeug beim nächsten Lauf
  /// wiedererkennt, und bleibt deshalb bewusst so stehen, wie die Datei es
  /// gesehen hat – eine spätere Korrektur im Admin verändert sie nicht.
  ///
  /// Bewusst NICHT eindeutig: Zwei in allen Spalten gleiche Fahrzeuge dürfen
  /// nebeneinander stehen. Der Import ordnet sie dann keiner Zeile zu, statt
  /// eine davon zu raten.
  importFingerprint String?

  // -- Preisblatt (PDF) -------------------------------------------------------
  /// Wann zuletzt Daten aus einem Preisblatt übernommen wurden.
  priceSheetImportedAt DateTime?
  /// Dateiname des zuletzt übernommenen Preisblatts.
  priceSheetSource     String?

  images       VehicleImage[]
  socialDrafts SocialDraft[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalSource, externalId])
  // Beide Merkmale sind je Bestand eindeutig. NULL bleibt in Postgres
  // beliebig oft erlaubt – von Hand angelegte Fahrzeuge stören sich nicht
  // daran.
  @@unique([vin])
  @@unique([stockNumber])
  @@index([missingSinceImportAt])
  @@index([active, priceCents])
  @@index([active, createdAt])
  @@index([active, make, model])
  @@index([active, fuel])
  @@index([active, transmission])
  @@index([active, mileageKm])
  @@index([active, firstRegistration])
  @@index([status, createdAt])
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url      String
  alt      String?
  position Int     @default(0)
  width    Int?
  height   Int?
  /// ID des Bildes beim Anbieter, für idempotente Syncs
  externalId String?

  @@unique([vehicleId, url])
  @@index([vehicleId, position])
}

// ---------------------------------------------------------------------------
// Unternehmensdaten (US-15, US-16)
// ---------------------------------------------------------------------------

/// Singleton – es existiert genau eine Zeile mit id = "default".
/// Bearbeitungsstand einer Kunden-Ankaufanfrage.
enum PurchaseInquiryStatus {
  NEW
  CONTACTED
  APPOINTMENT
  OFFER_MADE
  PURCHASED
  REJECTED
}

/// Ein Fahrzeug, das ein Kunde AutoTal verkaufen möchte (US-11).
///
/// BEWUSST KEIN Vehicle: Ein Vehicle ist ein Fahrzeug im eigenen Bestand mit
/// Preis, Bildern und Social-Media-Bezug. Eine Ankaufanfrage ist ein
/// Kundenkontakt mit Fahrzeugangaben aus zweiter Hand, die noch niemand
/// geprüft hat. Die beiden zu vermischen würde ungeprüfte Kundenangaben in
/// den Bestand tragen.
///
/// DATENSCHUTZ: Enthält personenbezogene Daten. Gespeichert wird nur, was das
/// Formular ohnehin erhebt und was für die Rückmeldung gebraucht wird. Für
/// eine Löschfrist ist die Datenschutzerklärung maßgeblich.
model VehiclePurchaseInquiry {
  id String @id @default(cuid())

  // -- Kunde ------------------------------------------------------------------
  customerName  String
  customerPhone String
  customerEmail String?

  // -- Fahrzeug (Angaben des Kunden, ungeprüft) -------------------------------
  make                  String
  model                 String
  firstRegistrationYear Int
  mileageKm             Int
  fuel                  FuelType
  transmission          TransmissionType
  /// Fahrgestellnummer, falls angegeben
  vin                   String?
  /// Preisvorstellung in Cent (Konvention des Projekts)
  priceExpectationCents Int?
  /// Freitext des Kunden zu Zustand und Anmerkungen
  message               String @default("")

  // -- Bearbeitung ------------------------------------------------------------
  /// ÜBERHOLT – wird nicht mehr gelesen und nicht mehr geschrieben.
  ///
  /// Bearbeitungsstand und Notiz stehen seit der Vereinheitlichung am
  /// zugehörigen CrmLead. Zwei Statusfelder für denselben Vorgang liefen
  /// auseinander: Wer im Ankauf auf „Angekauft“ stellte, sah im CRM weiter
  /// „Neu“. Die Spalten bleiben vorerst erhalten, damit die bisherigen Werte
  /// nicht verloren gehen; entfernt werden sie erst nach ausdrücklicher
  /// Freigabe.
  status        PurchaseInquiryStatus @default(NEW)
  /// Woher die Anfrage kam, derzeit immer "website"
  source        String                @default("website")
  /// ÜBERHOLT – siehe `status`. Maßgeblich ist CrmLead.internalNotes.
  internalNotes String                @default("")

  /// Gegenstück zur Relation in CrmLead – erlaubt den Sprung von der Anfrage
  /// zum Lead, ohne die Kundendaten hier ein zweites Mal zu halten.
  crmLead CrmLead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

model CompanySettings {
  id String @id @default("default")

  legalName   String
  displayName String
  tagline     String?
  aboutText   String  @default("")

  street     String
  postalCode String
  city       String
  country    String @default("Österreich")

  phone          String
  /// Nur Ziffern inkl. Ländervorwahl, z. B. "436641234567" (US-10)
  whatsappNumber String?
  email          String

  /// UID-Nummer
  vatId                   String?
  commercialRegisterNumber String?
  commercialRegisterCourt  String?

  // -- Gewerberechtliche Angaben fürs Impressum (§ 5 ECG, § 63 GewO) --------
  // Stehen im GISA-Auszug und ändern sich selten, gehören aber trotzdem in
  // die Datenbank: Ein Tippfehler im Impressum darf kein Deployment brauchen.
  /// Gewerbewortlaut laut Gewerberegister
  businessPurpose      String?
  /// Zuständige Bezirkshauptmannschaft bzw. Magistrat
  supervisoryAuthority String?
  /// GISA-Zahl aus dem Gewerbeinformationssystem Austria
  gisaNumber           String?

  contactPersonName  String?
  contactPersonRole  String?
  contactPersonEmail String?
  contactPersonPhone String?

  latitude  Float?
  longitude Float?

  willhabenUrl      String?
  autoscoutUrl      String?
  gebrauchtwagenUrl String?

  openingHours OpeningHour[]
  socialLinks  SocialLink[]

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

/// Ein Öffnungszeiten-Slot. Mehrere Zeilen pro Wochentag sind erlaubt
/// (z. B. Vormittag/Nachmittag mit Mittagspause).
model OpeningHour {
  id        String          @id @default(cuid())
  companyId String
  company   CompanySettings @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// 1 = Montag … 7 = Sonntag (ISO-8601)
  weekday  Int
  /// "HH:mm", null wenn geschlossen
  opensAt  String?
  closesAt String?
  closed   Boolean @default(false)
  note     String?
  position Int     @default(0)

  @@index([companyId, weekday, position])
}

model SocialLink {
  id        String          @id @default(cuid())
  companyId String
  company   CompanySettings @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// "instagram" | "facebook" | "tiktok" | "youtube" | "linkedin" | …
  platform String
  url      String
  label    String?
  position Int     @default(0)
  active   Boolean @default(true)

  @@unique([companyId, platform])
  @@index([companyId, position])
}

// ---------------------------------------------------------------------------
// Finanzierung (US-12, US-13, US-17)
// ---------------------------------------------------------------------------

/// Singleton – Standardwerte für den unverbindlichen Finanzierungsrechner.
model FinanceConfig {
  id String @id @default("default")

  /// Sollzinssatz p. a. in Basispunkten, z. B. 599 = 5,99 %
  defaultInterestRateBp Int @default(599)
  minInterestRateBp     Int @default(0)
  maxInterestRateBp     Int @default(1500)

  minTermMonths     Int @default(12)
  maxTermMonths     Int @default(96)
  defaultTermMonths Int @default(60)

  /// Anzahlung in Basispunkten des Fahrzeugpreises, 2000 = 20 %
  minDownPaymentBp     Int @default(0)
  maxDownPaymentBp     Int @default(8000)
  defaultDownPaymentBp Int @default(2000)

  /// Schlussrate (Ballon) in Basispunkten des Fahrzeugpreises
  minBalloonBp     Int @default(0)
  maxBalloonBp     Int @default(5000)
  defaultBalloonBp Int @default(0)

  /// Pflichthinweis: unverbindlich, keine Kreditzusage
  disclaimer String @default("")

  updatedAt DateTime @updatedAt

  @@map("finance_config")
}

model FinanceProvider {
  id          String  @id @default(cuid())
  name        String
  description String?
  logoUrl     String?
  websiteUrl  String?
  /// Optionaler partnerspezifischer Zinssatz in Basispunkten
  interestRateBp Int?
  position    Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

// ---------------------------------------------------------------------------
// KI / Social Media (EPIC 7 + 8)
// ---------------------------------------------------------------------------

enum SocialDraftStatus {
  DRAFT
  APPROVED
  PUBLISHED
  FAILED
}

enum SocialPlatform {
  INSTAGRAM
}

model SocialDraft {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  platform SocialPlatform    @default(INSTAGRAM)
  status   SocialDraftStatus @default(DRAFT)

  caption   String
  hashtags  String[] @default([])
  imageUrls String[] @default([])

  /// Nachvollziehbarkeit der Generierung
  generatedByModel String?
  generatedAt      DateTime?

  approvedAt     DateTime?
  approvedByUser String?

  publishedAt       DateTime?
  externalPostId    String?
  externalPermalink String?

  /// Für den Admin verständliche Fehlermeldung (US-24)
  errorMessage  String?
  retryCount    Int       @default(0)
  lastAttemptAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// Integrationen / Admin
// ---------------------------------------------------------------------------

/// Serverseitig gespeicherte Zugangsdaten externer Dienste.
/// `accessToken` wird mit AES-256-GCM verschlüsselt abgelegt
/// (siehe src/lib/crypto.ts). Wird NIE an den Client ausgeliefert.
model IntegrationCredential {
  id       String @id @default(cuid())
  /// "instagram"
  provider String @unique

  accessTokenEncrypted String
  externalAccountId    String?
  externalUsername     String?
  scopes               String[] @default([])

  expiresAt   DateTime?
  connectedAt DateTime  @default(now())
  active      Boolean   @default(true)

  updatedAt DateTime @updatedAt
}

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Fixed-Window-Zähler für das Rate Limiting öffentlicher Formulare.
/// DB-gestützt, damit es auch auf serverless Instanzen greift.
model RateLimitCounter {
  /// "<bucket>:<identifier>"
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

/// Anliegen eines Leads – aus Sicht des Kunden formuliert.
enum CrmLeadType {
  /// Kunde möchte ein Fahrzeug kaufen
  BUY
  /// Kunde möchte AutoTal ein Fahrzeug verkaufen
  SELL
  FINANCING
  TEST_DRIVE
  GENERAL
}

/// Bearbeitungsstand im Vertrieb.
enum CrmLeadStatus {
  NEW
  CONTACTED
  APPOINTMENT
  IN_PROGRESS
  WON
  LOST
}

/// Woher der Kontakt kam.
enum CrmLeadSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  WILLHABEN
  AUTOSCOUT
  GEBRAUCHTWAGEN
  /// Von Hand im Admin angelegt, etwa nach einem Telefonat
  MANUAL
}

/// Ein Kontakt aus einer Anfrage – die zentrale Arbeitsliste des Vertriebs.
///
/// Bewusst schlank: Der Lead hält nur, was zur Nachverfolgung nötig ist.
/// Fachliche Details eines angebotenen Fahrzeugs bleiben in
/// VehiclePurchaseInquiry und werden über die Relation gelesen, statt sie
/// hier ein zweites Mal zu speichern.
model CrmLead {
  id String @id @default(cuid())

  // -- Kontakt ----------------------------------------------------------------
  /// Mindestens eine Erreichbarkeit (phone oder email) wird beim Anlegen erzwungen
  name  String
  phone String?
  email String?

  // -- Einordnung -------------------------------------------------------------
  type   CrmLeadType
  source CrmLeadSource @default(WEBSITE)
  status CrmLeadStatus @default(NEW)

  /// Anliegen des Kunden, unverändert übernommen
  message String @default("")

  // -- Bearbeitung ------------------------------------------------------------
  /// Nur im Admin sichtbar
  internalNotes String    @default("")
  /// Wird gesetzt, wenn jemand den Kontakt dokumentiert
  lastContactAt DateTime?

  /// Archiviert – erledigt und aus den Arbeitslisten genommen.
  ///
  /// Bewusst ein Zeitpunkt statt eines Ja/Nein-Flags: So ist nachvollziehbar,
  /// wann etwas aus der Ansicht verschwunden ist. Archivierte Leads zählen
  /// weder in den Listen noch in der Statistik mit, bleiben aber vollständig
  /// erhalten und können zurückgeholt werden. Endgültiges Löschen ist ein
  /// eigener, ausdrücklicher Schritt aus dem Archiv heraus.
  archivedAt DateTime?

  /// Die zugehörige Ankaufanfrage, falls der Lead aus dem Ankaufformular
  /// stammt. Eins zu eins: Jede Anfrage erzeugt höchstens einen Lead.
  ///
  /// Seit der Vereinheitlichung ist der Lead die führende Zeile: Status und
  /// interne Notiz stehen HIER, nicht mehr an der Anfrage. Die Anfrage hält
  /// nur noch die Fahrzeugangaben des Kunden. Beide Ansichten im Admin
  /// bearbeiten damit denselben Datensatz.
  purchaseInquiryId String?                 @unique
  purchaseInquiry   VehiclePurchaseInquiry? @relation(fields: [purchaseInquiryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([archivedAt, createdAt])
  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([source, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Website-Interaktionen
// ---------------------------------------------------------------------------

/// Kanal einer angeklickten Kontakt- oder Plattform-Schaltfläche.
///
/// Bewusst NICHT identisch mit CrmLeadSource, obwohl sich die Namen ähneln.
/// Ein Klick ist keine Anfrage: Wer auf „WhatsApp“ klickt, hat noch nichts
/// geschrieben, und wer willhaben öffnet, hat kein Auto gekauft. Ein
/// gemeinsames Enum würde genau diese Verwechslung einladen.
enum InteractionChannel {
  WHATSAPP
  PHONE
  EMAIL
  WILLHABEN
  AUTOSCOUT
  GEBRAUCHTWAGEN
  INSTAGRAM
  TIKTOK
}

/// Tageszähler für Klicks auf ausgehende Kontakt- und Plattformlinks.
///
/// DATENSCHUTZ: Enthält KEINE personenbezogenen Daten – kein Datensatz je
/// Ereignis, keine IP-Adresse, kein User-Agent, keine Kennung, kein genauer
/// Zeitpunkt. Gespeichert wird ausschließlich, wie oft ein Kanal an einem Tag
/// angeklickt wurde. Ein einzelner Klick ist damit keiner Person zuordenbar,
/// auch nicht rückwirkend über eine Zusammenführung mit anderen Tabellen.
///
/// Die Tagesauflösung ist Absicht: Feiner wäre bei geringem Verkehr ein
/// Zeitstempel, über den sich ein Besuch mit anderen Quellen verknüpfen ließe.
model InteractionCounter {
  channel InteractionChannel
  /// Tag in lokaler Zeitrechnung, ohne Uhrzeit
  day     DateTime           @db.Date
  count   Int                @default(0)

  @@id([channel, day])
  @@index([day])
}
