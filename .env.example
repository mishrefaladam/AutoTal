# AutoTal – Umgebungsvariablen
#
# Kopiere diese Datei nach `.env` und trage die Werte ein:
#   cp .env.example .env
#
# Alle Werte hier sind SERVERSEITIG. Nur Variablen mit dem Präfix
# NEXT_PUBLIC_ landen im Browser-Bundle. Niemals einen API-Key mit
# NEXT_PUBLIC_ präfixen.

# === Pflicht ===============================================================

# PostgreSQL-Verbindung, die die Anwendung zur Laufzeit nutzt.
#
# Lokal: direkte Verbindung zur eigenen Postgres-Instanz.
# Produktion (Neon): die GEPOOLTE Verbindung – der Hostname enthält "-pooler".
#   Auf serverless Instanzen öffnet sonst jede Funktion eine eigene Verbindung
#   und die Datenbank läuft ins Verbindungslimit.
#
# Der Anbieter verlangt in der Regel SSL. Den Connection String deshalb
# unverändert übernehmen, inklusive "?sslmode=require".
DATABASE_URL="postgresql://user:password@localhost:5432/autotal?schema=public"

# Direkte (ungepoolte) Verbindung – NUR für Prisma-Migrationen.
#
# Vercel/Neon setzt diese Variable automatisch. Lokal bleibt sie leer; dann
# fallen Migrationen auf DIRECT_URL oder DATABASE_URL zurück.
DATABASE_URL_UNPOOLED=""

# Optionaler Legacy-Fallback für ältere Deployments. Nicht manuell duplizieren,
# wenn DATABASE_URL_UNPOOLED vorhanden ist.
DIRECT_URL=""

# Signaturschlüssel für Auth.js-Sessions. Erzeugen mit:
#   openssl rand -base64 32
AUTH_SECRET=""

# AES-256-GCM-Schlüssel zum Verschlüsseln gespeicherter Integrations-Tokens
# (z. B. Instagram). 32 Byte, base64-kodiert. Erzeugen mit:
#   openssl rand -base64 32
# ACHTUNG: Wird dieser Schlüssel gewechselt, müssen alle Integrationen neu
# verbunden werden.
ENCRYPTION_KEY=""

# Öffentliche Basis-URL – wird für Sitemap, robots.txt und OpenGraph benutzt.
NEXT_PUBLIC_SITE_URL="https://autotal.at"

# Development-only: Motion lokal zum Testen erzwingen, auch wenn das System
# reduzierte Bewegung meldet. In Production wird das Flag ignoriert.
NEXT_PUBLIC_FORCE_MOTION="false"

# === Bildspeicher =========================================================

# Vercel Blob – hier landen die im Admin hochgeladenen Fahrzeugbilder.
# Wird beim Anlegen eines Blob-Stores in Vercel automatisch gesetzt.
#
# Ohne Token schreibt die Anwendung lokal nach public/uploads. Das genügt für
# die Entwicklung, funktioniert auf Vercel aber NICHT: Dort ist das
# Dateisystem schreibgeschützt und bei jedem Deployment leer.
BLOB_READ_WRITE_TOKEN=""

# === Resend (E-Mail) =======================================================

# Ohne RESEND_API_KEY laufen alle Formulare im Dry-Run-Modus: Eingaben werden
# validiert und die Mail wird geloggt, aber nichts versendet. Das Formular
# meldet dem Nutzer dann einen freundlichen Fehler statt eines falschen Erfolgs.
RESEND_API_KEY=""
# Verifizierte Absenderadresse aus dem Resend-Dashboard.
RESEND_FROM_EMAIL="AutoTal <website@autotal.at>"
# Postfach, das Kontakt-, Probefahrt- und Ankaufanfragen empfängt.
CONTACT_INBOX_EMAIL="autotal.office@gmail.com"

# === OpenAI (Caption-Generierung) ==========================================

# Ohne Key ist die KI-Funktion im Admin sichtbar, aber deaktiviert.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# === Instagram Graph API ===================================================

# Meta-App mit instagram_basic + instagram_content_publish + pages_show_list.
# Es wird ein Instagram-*Business*-Account benötigt, der mit einer
# Facebook-Seite verknüpft ist. Siehe src/integrations/instagram/README.md
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="https://autotal.at/api/integrations/instagram/callback"

# === Seed ==================================================================

# Zugangsdaten des ersten Admin-Benutzers, den `npm run db:seed` anlegt.
# Nach dem ersten Login unbedingt ändern.
SEED_ADMIN_EMAIL="admin@autotal.at"
SEED_ADMIN_PASSWORD=""
