# AutoTal – Umgebungsvariablen
#
# Kopiere diese Datei nach `.env` und trage die Werte ein:
#   cp .env.example .env
#
# Alle Werte hier sind SERVERSEITIG. Nur Variablen mit dem Präfix
# NEXT_PUBLIC_ landen im Browser-Bundle. Niemals einen API-Key mit
# NEXT_PUBLIC_ präfixen.

# === Pflicht ===============================================================

# PostgreSQL-Verbindung.
DATABASE_URL="postgresql://user:password@localhost:5432/autotal?schema=public"

# Signaturschlüssel für Auth.js-Sessions. Erzeugen mit:
#   openssl rand -base64 32
AUTH_SECRET=""

# AES-256-GCM-Schlüssel zum Verschlüsseln gespeicherter Integrations-Tokens
# (z. B. Instagram). 32 Byte, base64-kodiert. Erzeugen mit:
#   openssl rand -base64 32
# ACHTUNG: Wird dieser Schlüssel gewechselt, müssen alle Integrationen neu
# verbunden werden.
ENCRYPTION_KEY=""

# Öffentliche Basis-URL – wird für Sitemap, robots.txt und OpenGraph benutzt.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# === Fahrzeugquelle ========================================================

# Welcher VehicleProvider geladen wird: mock | autopro24 | willhaben
# "mock" liefert 12 realistische Testfahrzeuge und braucht keinerlei Zugang.
VEHICLE_PROVIDER="mock"

# Nur relevant für die noch nicht freigeschalteten echten Provider.
# Solange keine offizielle Doku/Zugangsdaten vorliegen, bleibt das leer und
# der Provider wirft eine sprechende Fehlermeldung. Siehe
# src/integrations/vehicles/README.md
AUTOPRO24_API_BASE_URL=""
AUTOPRO24_API_KEY=""
AUTOPRO24_DEALER_ID=""

WILLHABEN_API_BASE_URL=""
WILLHABEN_API_KEY=""
WILLHABEN_DEALER_ID=""

# Shared Secret für POST /api/cron/sync-vehicles (Vercel Cron / externer Trigger).
# Ohne gesetzten Wert ist der Endpunkt deaktiviert.
SYNC_CRON_SECRET=""


# === Resend (E-Mail) =======================================================

# Ohne RESEND_API_KEY laufen alle Formulare im Dry-Run-Modus: Eingaben werden
# validiert und die Mail wird geloggt, aber nichts versendet. Das Formular
# meldet dem Nutzer dann einen freundlichen Fehler statt eines falschen Erfolgs.
RESEND_API_KEY=""
# Verifizierte Absenderadresse aus dem Resend-Dashboard.
RESEND_FROM_EMAIL="AutoTal Website <website@deine-domain.at>"
# Postfach, das Kontakt-, Probefahrt- und Ankaufanfragen empfängt.
CONTACT_INBOX_EMAIL="verkauf@deine-domain.at"


# === OpenAI (Caption-Generierung) ==========================================

# Ohne Key ist die KI-Funktion im Admin sichtbar, aber deaktiviert.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"


# === Instagram Graph API ===================================================

# Meta-App mit instagram_basic + instagram_content_publish + pages_show_list.
# Es wird ein Instagram-*Business*-Account benötigt, der mit einer
# Facebook-Seite verknüpft ist. Siehe src/integrations/instagram/README.md
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/integrations/instagram/callback"


# === Seed ==================================================================

# Zugangsdaten des ersten Admin-Benutzers, den `npm run db:seed` anlegt.
# Nach dem ersten Login unbedingt ändern.
SEED_ADMIN_EMAIL="admin@autotal.at"
SEED_ADMIN_PASSWORD=""
